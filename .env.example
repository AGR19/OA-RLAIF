# Copy to .env and fill in on each machine. Never commit .env.
# Raw data locations (defaults are relative to this folder on the Mac).
OA_RAW_DIR="../OA Finetune Small Model/datasets/Raw Ontology Folders"
OA_BIOML_DIR=../data/external/bio-ml
# extra datasource papers (PDF folder, e.g. the 'Matching Surveys' folder); default data/external/matching_surveys
OA_PAPERS_DIR=
# cybersecurity zero-shot test (IoTSec -> UCO): project folder and its reference.csv
OA_CYBER_DIR=
OA_CYBER_REFERENCE=
OA_DATA_DIR=data
OA_OUT_DIR=outputs

# A4B judge / question generator: any OpenAI-compatible endpoint serving Gemma 4 26B-A4B.
JUDGE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
JUDGE_API_KEY=
JUDGE_MODEL=gemma-4-26b-a4b-it
JUDGE_USD_PER_MTOK_IN=0
JUDGE_USD_PER_MTOK_OUT=0
JUDGE_RPM=14
JUDGE_MAX_TOKENS=4096

# Hugging Face: run `hf auth login` yourself; only the namespace is configured here.
HF_NAMESPACE=

# Budget guard (USD). GPU rate is per hour for the whole instance.
OA_GPU_USD_PER_HOUR=27.16
OA_BUDGET_USD=500
OA_BUDGET_STOP_USD=450

# Keep the harness offline: LiteLLM uses its bundled model price map instead of fetching one.
LITELLM_LOCAL_MODEL_COST_MAP=True
MSWEA_SILENT_STARTUP=1

# DRAL-OA FastText model (300d, ~2.9 GB). Needed only where the mapping layer is fitted (the Mac).
OA_FASTTEXT_BIN=
